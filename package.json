{
  "name": "denju-workspace",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "docs",
    "packages/npm"
  ],
  "scripts": {
    "check": "bun run npm:check && bun run docs:check && bun run docs:build",
    "docs:dev": "bun run --cwd docs dev",
    "docs:check": "bun run --cwd docs check",
    "docs:build": "bun run --cwd docs build",
    "npm:check": "bun run --cwd packages/npm check"
  }
}
