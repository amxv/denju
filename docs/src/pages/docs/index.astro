---
import { getCollection } from "astro:content";
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import DocsPageActions from "zuedocs/components/DocsPageActions.astro";
import { docCategories, docCategoryDetails, primaryNav, siteConfig } from "../../data/docs";

const entries = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const grouped = docCategories
  .map((category) => ({
    category,
    description: docCategoryDetails[category],
    entries: entries.filter((entry) => entry.data.category === category)
  }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  title={`${siteConfig.name} Docs`}
  description="Learn Denju from first subscription through publishing, teams, self-hosting, architecture, and repository development."
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <section class="shell docs-index-hero">
    <div class="docs-index-hero__head">
      <div>
        <p class="section-label">Documentation</p>
        <h1>Start with the workflow. Dive into the machinery only when you want to.</h1>
      </div>
      <DocsPageActions />
    </div>
    <p>
      New to Denju? Begin with Start, then use the task-focused guides as you need them. Running your
      own registry has a separate path. Merkle objects, reconciliation, storage, and performance live
      under Architecture so normal users never have to learn the implementation to get value from it.
    </p>
  </section>

  <section class="shell docs-index">
    {grouped.map((group) => (
      <section class="docs-index__group">
        <div class="docs-index__group-head">
          <div>
            <p class="section-label">{group.category}</p>
            <p>{group.description}</p>
          </div>
        </div>
        <div class="docs-index__cards">
          {group.entries.map((entry) => (
            <a class="docs-index__card" href={`/docs/${entry.id}`}>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
              <span>Open guide</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>

<script>
  import "zuedocs/docsEnhancements";
</script>
