---
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";
import "../styles/landing.css";
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <main class="denju-landing">
    <section class="denju-hero shell">
      <div class="hero-layout">
        <div class="hero-copy">
          <h1>The right skills, current everywhere.</h1>
          <p class="hero-lede">
            Discover Agent Skills or bring your own. Denju keeps public subscriptions, private skills,
            shared skills, packs, and team skill sets current wherever your agents run.
          </p>
          <p class="denju-meaning"><strong>denju · <span lang="ja">伝授</span></strong> — Japanese for passing on or transmitting knowledge or a skill.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/docs/start/install">Get started <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/docs/start/what-is-denju">How Denju works</a>
          </div>
          <div class="hero-facts">
            <span>Anonymous public use</span>
            <span>Private sync built in</span>
            <span>Codex + Claude Code</span>
          </div>
        </div>

        <div class="subscription-demo">
          <div class="demo-caption">
            <span>your private skill</span>
            <small>three machines</small>
          </div>
          <div class="demo-card demo-skill">
            <div class="demo-card-head">
              <div>
                <span class="demo-kicker">private · only you</span>
                <strong>@alice/contract-review</strong>
              </div>
              <span class="privacy-badge">private</span>
            </div>
            <p>Your own contract-review workflow, references, scripts, and supporting files.</p>
            <div class="release-row">
              <span>saved</span>
              <strong>private version</strong>
              <i aria-hidden="true"></i>
              <span>8m ago</span>
            </div>
          </div>
          <div class="sync-spine" aria-hidden="true">
            <span class="sync-spine__line"></span>
            <span class="sync-spine__pulse"></span>
          </div>
          <div class="device-list">
            <div class="device-row">
              <span class="device-icon">M</span>
              <div><strong>MacBook</strong><small>Codex · Claude Code</small></div>
              <span class="device-version">latest</span>
              <span class="sync-state">current</span>
            </div>
            <div class="device-row">
              <span class="device-icon">W</span>
              <div><strong>Workstation</strong><small>Codex</small></div>
              <span class="device-version">latest</span>
              <span class="sync-state">current</span>
            </div>
            <div class="device-row device-row-muted">
              <span class="device-icon">L</span>
              <div><strong>Offline laptop</strong><small>last seen yesterday</small></div>
              <span class="device-version">older</span>
              <span class="sync-state">updates on reconnect</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="story-section problem shell">
      <div class="story-number" aria-hidden="true">01</div>
      <div class="story-copy">
        <div class="section-label">Why Denju exists</div>
        <h2>Folders are simple.<br />Copies drift.</h2>
        <p>
          Agent Skills are ordinary directories. That is great until the same skill exists on three machines,
          in two harnesses, and on a teammate's laptop. Denju replaces manual copies with durable relationships.
        </p>
      </div>
      <div class="drift-visual">
        <div class="drift-stack">
          <div><code>review/</code><b>v4</b><small>MacBook</small></div>
          <div><code>review/</code><b>v3</b><small>Workstation</small></div>
          <div><code>review-copy/</code><b>?</b><small>teammate</small></div>
        </div>
        <div class="drift-arrow" aria-hidden="true">→</div>
        <div class="relationship-card">
          <span>one relationship</span>
          <code>@alice/review → latest</code>
          <small>Denju keeps the copies true.</small>
        </div>
      </div>
    </section>

    <section class="story-section story-section--reverse discovery shell">
      <div class="story-copy">
        <div class="section-label">Discover</div>
        <h2>Find useful skills before you make your own.</h2>
        <p>
          Search the public registry, inspect authors and releases, browse topics, and see what people star.
          You do not need an account to search, inspect, or subscribe.
        </p>
        <a class="inline-link" href="/docs/guides/discover-and-subscribe">Discover and subscribe <span>→</span></a>
      </div>
      <div class="search-visual">
        <div class="search-box"><span aria-hidden="true">⌕</span><code>legal research</code><kbd>⌘ K</kbd></div>
        <div class="search-result search-result--active">
          <div><strong>@northstar/legal-research</strong><small>Deep legal research workflows and citation discipline.</small></div>
          <span>★ 421</span>
        </div>
        <div class="search-result">
          <div><strong>@maya/case-analysis</strong><small>Analyze facts, issues, and competing interpretations.</small></div>
          <span>★ 188</span>
        </div>
        <div class="search-result">
          <div><strong>@lex/contracts</strong><small>Contract review with structured risk checks.</small></div>
          <span>★ 104</span>
        </div>
        <div class="search-foot"><span>public registry</span><span>no account required</span></div>
      </div>
    </section>

    <section class="story-section subscriptions shell">
      <div class="story-copy">
        <div class="section-label">Subscribe</div>
        <h2>Install once. Then stop thinking about updates.</h2>
        <p>
          A subscription means “keep this skill here.” Follow <code>latest</code> for automatic updates or pin
          one immutable release when stability matters.
        </p>
        <a class="inline-link" href="/docs/guides/discover-and-subscribe#pin-an-exact-release">Subscriptions and pins <span>→</span></a>
      </div>
      <div class="release-visual">
        <div class="release-skill"><code>@alice/review</code><span>subscription</span></div>
        <div class="release-track" aria-hidden="true">
          <i></i><i></i><i></i><i class="release-track__current"></i>
        </div>
        <div class="release-labels"><span>v1</span><span>v2</span><span>v3</span><strong>v4 · latest</strong></div>
        <div class="release-choice">
          <div><small>default</small><strong>follow latest</strong><span>moves when the publisher releases</span></div>
          <div><small>optional</small><strong>pin v3</strong><span>stays exactly where you put it</span></div>
        </div>
      </div>
    </section>

    <section class="story-section story-section--reverse personal-private shell">
      <div class="story-copy">
        <div class="section-label">Your private skills</div>
        <h2>Keep it private.<br />Keep it everywhere.</h2>
        <p>
          Import a skill once. It stays private, and your saved changes follow you across signed-in devices.
          No publish step. No second sync tool.
        </p>
        <a class="inline-link" href="/docs/guides/publish-and-edit#private-sync-works-before-you-publish">Private multi-device sync <span>→</span></a>
      </div>
      <div class="private-device-visual">
        <div class="private-skill-node"><span>private</span><code>@alice/my-skill</code></div>
        <div class="private-device-rail" aria-hidden="true"></div>
        <div class="private-device-list">
          <div><b>M</b><span>MacBook</span><em>current</em></div>
          <div><b>W</b><span>Workstation</span><em>current</em></div>
          <div><b>L</b><span>Laptop</span><em>current</em></div>
        </div>
        <small>Valid saves sync automatically after you sign in.</small>
      </div>
    </section>

    <section class="story-section private-share shell">
      <div class="story-copy">
        <div class="section-label">Private sharing</div>
        <h2>Share with one person,<br />not the internet.</h2>
        <p>
          Grant one Denju user access with <code>denju share</code>. They choose whether to subscribe; if they do,
          their private copy follows your saved changes while the skill stays out of the public catalog.
        </p>
        <a class="inline-link" href="/docs/guides/forks-and-proposals#share-a-private-skill">Private sharing <span>→</span></a>
      </div>
      <div class="share-visual">
        <div class="share-owner"><span>A</span><div><small>owner</small><strong>@alice/my-skill</strong></div></div>
        <div class="share-command"><code>denju share @alice/my-skill @bob</code></div>
        <div class="share-permission"><span>private access</span><i aria-hidden="true">→</i></div>
        <div class="share-recipient"><span>B</span><div><small>recipient</small><strong>@bob</strong></div></div>
        <div class="share-subscribe"><code>denju subscribe @alice/my-skill</code><small>Bob opts in</small></div>
      </div>
    </section>

    <section class="story-section story-section--reverse publishing shell">
      <div class="story-copy">
        <div class="section-label">Publish</div>
        <h2>Private while you work.<br />Public when you decide.</h2>
        <p>
          Personal skills start private. Publishing turns the current private state into an immutable numbered
          release for everyone else. Fix mistakes by publishing the next release, not by rewriting history.
        </p>
        <a class="inline-link" href="/docs/guides/publish-and-edit#publish-a-public-release-when-you-choose">Publishing releases <span>→</span></a>
      </div>
      <div class="publish-visual">
        <div class="publish-draft"><span>private</span><code>@alice/review</code><small>saved changes</small></div>
        <div class="publish-action"><code>denju publish @alice/review</code><i aria-hidden="true">→</i></div>
        <div class="publish-history">
          <div><small>release</small><strong>v1</strong></div>
          <div><small>release</small><strong>v2</strong></div>
          <div class="publish-history__latest"><small>latest</small><strong>v3</strong></div>
        </div>
      </div>
    </section>

    <section class="story-section packs shell">
      <div class="story-copy">
        <div class="section-label">Packs</div>
        <h2>A pack is just a set of skills.</h2>
        <p>
          Group the skills that belong together. Add one, remove one, follow latest, or pin a version.
          One pack subscription keeps the whole set current.
        </p>
        <a class="inline-link" href="/docs/guides/packs">Packs <span>→</span></a>
      </div>
      <div class="pack-visual">
        <div class="pack-visual__title"><code>@northstar/packs/legal-core</code><span>v18</span></div>
        <div><span>contract-review</span><b>latest</b></div>
        <div><span>legal-research</span><b>latest</b></div>
        <div><span>citation-check</span><b>v3</b></div>
        <div><span>client-letter-draft</span><b>latest</b></div>
        <div class="pack-visual__change"><span>+ litigation-prep</span><small>added once → subscribers receive it</small></div>
      </div>
    </section>

    <section class="team-story shell">
      <div class="team-copy">
        <div class="section-label">Private teams</div>
        <h2>Private to the team<br />by default.</h2>
        <p>
          A normal team publish creates a team-only release. Put private team skills in an assigned pack and
          Denju keeps the approved set on every current member's computers—and on future members when they join.
        </p>
        <a class="inline-link inline-link--light" href="/docs/guides/teams">Teams and assigned packs <span>→</span></a>
      </div>
      <div class="team-visual">
        <div class="pack-card">
          <div class="pack-title"><span>@northstar/packs/legal-core</span><strong>private</strong></div>
          <div><span>contract-review</span><b>latest</b></div>
          <div><span>legal-research</span><b>latest</b></div>
          <div><span>citation-check</span><b>v3</b></div>
          <div><span>client-letter-draft</span><b>latest</b></div>
        </div>
        <div class="pack-assignment"><span>assign once</span><i>→</i></div>
        <div class="member-grid">
          <div><span>A</span><small>4 skills</small></div>
          <div><span>B</span><small>4 skills</small></div>
          <div><span>C</span><small>4 skills</small></div>
          <div><span>new</span><small>syncs on join</small></div>
        </div>
      </div>
    </section>

    <section class="story-section story-section--reverse collaboration shell">
      <div class="story-copy">
        <div class="section-label">Safe to edit</div>
        <h2>Edit somebody else's skill.<br />Keep your work.</h2>
        <p>
          Editing a subscribed skill does not mutate upstream. Denju turns your change into a fork, lets you
          sync upstream explicitly, and lets you propose the result back when it is ready.
        </p>
        <a class="inline-link" href="/docs/guides/forks-and-proposals">Forks and proposals <span>→</span></a>
      </div>
      <div class="fork-visual">
        <div><span>01</span><strong>Edit normally</strong><small>through the filesystem your agent already uses</small></div>
        <i aria-hidden="true">↓</i>
        <div><span>02</span><strong>Your fork</strong><small>your work is independent and preserved</small></div>
        <i aria-hidden="true">↓</i>
        <div><span>03</span><strong>Propose</strong><small>send the current result back upstream</small></div>
      </div>
    </section>

    <section class="story-section sync-story shell">
      <div class="story-copy">
        <div class="section-label">Offline and conflicts</div>
        <h2>Go offline. Come back.<br />Catch up to now.</h2>
        <p>
          Private edits queue locally. When connectivity returns, Denju syncs current state rather than replaying
          every missed event. Concurrent edits merge when they can; real conflicts preserve both sides.
        </p>
        <a class="inline-link" href="/docs/guides/sync-and-conflicts">Sync and conflicts <span>→</span></a>
      </div>
      <div class="sync-visual">
        <div class="sync-device"><span>L</span><strong>offline laptop</strong><small>3 private saves queued</small></div>
        <div class="sync-gap"><span>offline for 2 days</span><i aria-hidden="true"></i></div>
        <div class="sync-registry"><span>R</span><strong>registry</strong><small>current heads</small></div>
        <div class="sync-result"><span>reconnect</span><strong>compare what matters now</strong><small>merge clean edits · surface real conflicts</small></div>
      </div>
    </section>

    <section class="story-section story-section--reverse social shell">
      <div class="story-copy">
        <div class="section-label">Discovery signals</div>
        <h2>Follow people.<br />Star skills. Install nothing by accident.</h2>
        <p>
          Profiles, follows, stars, topics, and rankings help you discover good work. They are deliberately
          separate from subscriptions: social actions never change your filesystem.
        </p>
        <a class="inline-link" href="/docs/guides/discovery-and-social">Discovery and social <span>→</span></a>
      </div>
      <div class="social-visual">
        <div class="profile-card"><span class="profile-avatar">A</span><div><strong>@alice</strong><small>agent tooling · legal workflows</small></div><em>Following</em></div>
        <div class="social-skill"><div><strong>@alice/review</strong><small>★ 482 · topic: review</small></div><span>starred</span></div>
        <div class="social-divider"><span>social</span><i></i><span>installed</span></div>
        <div class="social-note"><strong>Nothing changed on disk.</strong><small>Subscribe only when you want the skill installed.</small></div>
      </div>
    </section>

    <section class="story-section lifecycle shell">
      <div class="story-copy">
        <div class="section-label">Manage over time</div>
        <h2>Rename it. Move it.<br />Retire it without surprises.</h2>
        <p>
          Rename skills and packs, move them into teams, deprecate old ones, unpublish, export, or delete.
          Existing relationships follow the underlying skill instead of breaking on every name change.
        </p>
        <a class="inline-link" href="/docs/guides/lifecycle">Manage skills and packs <span>→</span></a>
      </div>
      <div class="lifecycle-visual">
        <div><code>@alice/review</code><span>rename</span><code>@alice/code-review</code></div>
        <div><code>@alice/code-review</code><span>transfer</span><code>@acme/code-review</code></div>
        <div><code>@acme/code-review</code><span>deprecate</span><code>→ @acme/review-v2</code></div>
        <small>History, subscriptions, and provenance stay attached.</small>
      </div>
    </section>

    <section class="story-section story-section--reverse trust shell">
      <div class="story-copy">
        <div class="section-label">Trust and safety</div>
        <h2>Verify what Denju can verify.</h2>
        <p>
          Denju verifies access, skill structure, hashes, and complete downloads before updates become visible.
          It does not pretend to know whether arbitrary skill instructions are safe; subscribing remains a trust decision.
        </p>
        <a class="inline-link" href="/docs/guides/trust-and-safety">Trust and safety <span>→</span></a>
      </div>
      <div class="trust-visual">
        <div class="trust-list trust-list--yes">
          <span>Denju verifies</span>
          <div>✓ authorized access</div><div>✓ Agent Skill structure</div><div>✓ content hashes</div><div>✓ complete update before switch</div>
        </div>
        <div class="trust-list trust-list--no">
          <span>Denju does not claim</span>
          <div>— malware scanning</div><div>— secret scanning</div><div>— runtime sandboxing</div><div>— instruction quality</div>
        </div>
      </div>
    </section>

    <section class="self-host shell">
      <div class="self-host-card">
        <div class="self-host-copy">
          <div class="section-label">Self-host</div>
          <h2>The hosted registry.<br />Or your registry.</h2>
          <p>
            Run the same open-source <code>denju-server</code> with PostgreSQL and S3-compatible storage.
            The client experience stays the same; only the registry origin changes.
          </p>
          <div class="self-host-actions">
            <a class="button button-primary" href="/docs/self-host/quickstart">Self-host Denju <span>→</span></a>
            <a class="button button-secondary" href="https://github.com/amxv/denju" target="_blank" rel="noreferrer">View source</a>
          </div>
        </div>
        <div class="infra-stack">
          <div class="infra-line" aria-hidden="true"></div>
          <div class="infra-main"><span>denju-server</span><small>same open-source server</small></div>
          <div class="infra-children">
            <div><strong>PostgreSQL</strong><small>accounts · skills · packs · teams</small></div>
            <div><strong>S3 compatible</strong><small>skill files and releases</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="quickstart shell">
      <div class="quickstart-card">
        <div class="quickstart-copy">
          <div class="section-label">Start here</div>
          <h2>Your first skill is four commands away.</h2>
          <p>Setup, search, and public subscriptions are anonymous. Claim an identity later when you need private account features.</p>
        </div>
        <pre><code><span>$</span> denju setup
<span>$</span> denju search "react performance"
<span>$</span> denju show @ashray/react-performance
<span>$</span> denju subscribe @ashray/react-performance</code></pre>
        <div class="quickstart-actions">
          <a class="button button-inverse" href="/docs/start/install">Install Denju <span>→</span></a>
          <a class="text-link-inverse" href="/docs">Browse documentation →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
