---
import BaseLayout from "zuedocs/layouts/BaseLayout.astro";
import { primaryNav, siteConfig } from "../data/docs";
import "../styles/landing.css";

const productIdeas = [
  {
    index: "01",
    title: "Find skills",
    body: "Search the public registry, inspect releases and authors, and subscribe without creating an account.",
    href: "/docs/guides/discover-and-subscribe"
  },
  {
    index: "02",
    title: "Sync private skills",
    body: "Bring an existing skill into Denju and it stays private while valid saves follow you across your signed-in devices. Publish only if you want to.",
    href: "/docs/guides/publish-and-edit"
  },
  {
    index: "03",
    title: "Bundle skills",
    body: "Put related skills into a pack. Subscribe once and Denju keeps the whole set current as skills are added, removed, or updated.",
    href: "/docs/guides/packs"
  },
  {
    index: "04",
    title: "Keep teams aligned",
    body: "Assign a pack to a team and Denju keeps those approved skills on every current and future team member's computers.",
    href: "/docs/guides/teams"
  }
];

const architecturePoints = [
  ["Changed file, changed bytes", "Denju reuses unchanged content, so editing one file does not turn the whole skill into a new transfer."],
  ["Catch up to now", "After being offline, Denju asks what should be installed now instead of replaying every update that happened while you were away."],
  ["Never half-updated", "A complete update is downloaded and verified before Denju exposes it to your agents."],
];
---

<BaseLayout
  title={`${siteConfig.name} | ${siteConfig.strapline}`}
  description={siteConfig.description}
  siteConfig={siteConfig}
  primaryNav={primaryNav}
>
  <main class="denju-landing">
    <section class="denju-hero shell">
      <div class="hero-layout">
        <div class="hero-copy">
          <h1>The right skills, current everywhere.</h1>
          <p class="hero-lede">
            Find useful Agent Skills or bring your own. Denju keeps public subscriptions and your private
            skills current across your signed-in devices automatically. Teams get the same private sync
            for team-owned skills—without setting up another file-sharing system.
          </p>
          <p class="denju-meaning"><strong>denju · <span lang="ja">伝授</span></strong> — Japanese for passing on or transmitting knowledge or a skill.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/docs/start/install">Get started <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/docs/start/what-is-denju">How Denju works</a>
          </div>
          <div class="hero-facts">
            <span>No account to search</span>
            <span>Private skills sync across devices</span>
            <span>Codex + Claude Code</span>
          </div>
        </div>

        <div class="subscription-demo">
          <div class="demo-caption">
            <span>your private skill</span>
            <small>three machines</small>
          </div>

          <div class="demo-card demo-skill">
            <div class="demo-card-head">
              <div>
                <span class="demo-kicker">private · only you</span>
                <strong>@alice/contract-review</strong>
              </div>
              <span class="privacy-badge">private</span>
            </div>
            <p>Your own contract-review workflow, references, scripts, and supporting files.</p>
            <div class="release-row">
              <span>saved</span>
              <strong>private version</strong>
              <i aria-hidden="true"></i>
              <span>8m ago</span>
            </div>
          </div>

          <div class="sync-spine" aria-hidden="true">
            <span class="sync-spine__line"></span>
            <span class="sync-spine__pulse"></span>
          </div>

          <div class="device-list">
            <div class="device-row">
              <span class="device-icon">M</span>
              <div><strong>MacBook</strong><small>Codex · Claude Code</small></div>
              <span class="device-version">latest</span>
              <span class="sync-state">current</span>
            </div>
            <div class="device-row">
              <span class="device-icon">W</span>
              <div><strong>Workstation</strong><small>Codex</small></div>
              <span class="device-version">latest</span>
              <span class="sync-state">current</span>
            </div>
            <div class="device-row device-row-muted">
              <span class="device-icon">L</span>
              <div><strong>Offline laptop</strong><small>last seen yesterday</small></div>
              <span class="device-version">older</span>
              <span class="sync-state">updates on reconnect</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="problem shell">
      <div class="problem-index" aria-hidden="true">01</div>
      <div class="section-label">Why Denju exists</div>
      <div class="problem-grid">
        <h2>Folders are wonderfully simple.<br />Copies are not.</h2>
        <div class="problem-copy">
          <p>
            Agent Skills are ordinary directories. That makes them portable and easy to inspect. But once
            the same skill lives on two machines, in two harnesses, or across a team, those copies drift.
          </p>
          <p>
            Denju keeps the relationship instead of the copy. Subscribe to a skill or pack once, and Denju
            keeps the correct files and versions on each machine for you.
          </p>
        </div>
      </div>

      <div class="drift-story">
        <div class="drift-side">
          <span class="comparison-label">copied folders</span>
          <div class="drift-files">
            <div class="drift-file drift-file-a"><code>review/</code><b>v4</b><small>MacBook</small></div>
            <div class="drift-file drift-file-b"><code>review/</code><b>v3</b><small>Workstation</small></div>
            <div class="drift-file drift-file-c"><code>review-copy/</code><b>?</b><small>teammate</small></div>
          </div>
          <p>Three folders. Three states. No relationship between them.</p>
        </div>

        <div class="drift-divider" aria-hidden="true"><span>becomes</span><i>→</i></div>

        <div class="subscription-side">
          <span class="comparison-label">one subscription</span>
          <div class="subscription-source"><code>@alice/review</code><span>latest</span></div>
          <div class="subscription-targets">
            <div><span>MacBook</span><b>v4</b></div>
            <div><span>Workstation</span><b>v4</b></div>
            <div><span>teammate</span><b>v4</b></div>
          </div>
          <p>One relationship. Denju keeps every managed copy current.</p>
        </div>
      </div>
    </section>

    <section class="private-sync shell">
      <div class="section-label">Private sync</div>
      <div class="private-sync-heading">
        <h2>Private does not mean stuck on one machine.</h2>
        <p>
          Denju is useful even if you never publish anything publicly. Private skills are first-class:
          your own skills can follow you across devices, you can share one privately with another Denju
          user, and team-private skills can follow the people who need them.
        </p>
      </div>

      <div class="private-sync-grid">
        <article class="private-sync-card">
          <span class="private-sync-label">Your devices</span>
          <h3>Private skills follow you.</h3>
          <p>
            Import a skill once. It starts private, and valid saves synchronize to your other signed-in
            Denju devices automatically. There is no separate “private sync” mode and no need to publish.
          </p>
          <div class="private-sync-flow" aria-hidden="true">
            <code>@alice/my-skill</code><i>→</i><span>MacBook</span><i>→</i><span>Workstation</span>
          </div>
        </article>

        <article class="private-sync-card private-sync-card--share">
          <span class="private-sync-label">One person</span>
          <h3>Share privately. Stay private.</h3>
          <p>
            Give another Denju user access with <code>denju share</code>. The skill never enters the public
            catalog. They choose whether to subscribe, and a private subscription follows your valid saves.
          </p>
          <div class="private-sync-flow" aria-hidden="true">
            <code>@alice/my-skill</code><i>→</i><span>@bob</span><i>→</i><span>private subscription</span>
          </div>
          <small>Sharing grants access; it does not silently install anything on the recipient's machine.</small>
        </article>

        <article class="private-sync-card private-sync-card--team">
          <span class="private-sync-label">Your team</span>
          <h3>Team skills stay private to the team by default.</h3>
          <p>
            A normal team publish creates a team-only release. Put those private team skills in an assigned
            pack and Denju keeps them current across current and future team members automatically.
          </p>
          <div class="private-sync-flow" aria-hidden="true">
            <code>@northstar/legal-research</code><i>→</i><span>team-only</span><i>→</i><span>everyone</span>
          </div>
          <small>Unfinished maintainer edits remain private to that maintainer until a team release is published.</small>
        </article>
      </div>
    </section>

    <section class="model shell" id="model">
      <div class="section-label">The product model</div>
      <div class="model-heading">
        <h2>Four ideas.<br />That is almost all of Denju.</h2>
        <p>
          Denju does not turn skills into Git repositories or dependency graphs. The product stays small
          enough to explain in one line: <strong>skills → subscriptions → packs → teams.</strong>
        </p>
      </div>

      <div class="model-flow">
        <article class="model-node model-node--skill">
          <span class="model-number">01</span>
          <h3>Skill</h3>
          <div class="model-example"><code>@alice/review</code><span>v1</span><span>v2</span><span class="active">v3</span></div>
          <p>An ordinary Agent Skill directory you can publish in numbered releases.</p>
        </article>
        <article class="model-node model-node--subscription">
          <span class="model-number">02</span>
          <h3>Subscription</h3>
          <div class="model-example"><code>@alice/review</code><span class="operator">→</span><span class="active">latest</span></div>
          <p>Keep this skill installed. Follow latest, or pin one exact release.</p>
        </article>
        <article class="model-node model-node--pack">
          <span class="model-number">03</span>
          <h3>Pack</h3>
          <div class="model-example model-example-pack"><span>review</span><span>research</span><span>drafting</span></div>
          <p>A set of skills that belong together. Subscribe once and keep the whole set current.</p>
        </article>
        <article class="model-node model-node--team">
          <span class="model-number">04</span>
          <h3>Team</h3>
          <div class="model-example"><code>@acme/packs/core</code><span class="operator">→</span><span class="active">people</span></div>
          <p>Assign a pack and Denju keeps those skills on every team member's computers.</p>
        </article>
        <div class="model-rail" aria-hidden="true"></div>
      </div>
    </section>

    <section class="product shell">
      <div class="section-label">What you can do</div>
      <div class="product-heading">
        <h2>Start with one useful skill.<br />Grow only when you need to.</h2>
        <p>
          Public use is anonymous. Claim an identity when you want private skills to follow you across
          devices, then publish publicly only when sharing with the wider registry becomes useful.
        </p>
      </div>

      <div class="product-grid">
        {productIdeas.map((item) => (
          <a class={`product-item product-item--${item.index}`} href={item.href}>
            <span class="product-index">{item.index}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
            <span class="product-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="team-story shell">
      <div class="team-copy">
        <div class="section-label">The team use case</div>
        <h2>Change the pack once.<br />Everyone stays current.</h2>
        <p>
          Imagine a legal team with approved skills for contract review, legal research, citation checking,
          and drafting. Those skills can stay private to the team. Put them in one pack, assign it once, and
          Denju keeps that private set on every team member's computers—including people who join later.
        </p>
        <a class="inline-link inline-link--light" href="/docs/guides/teams">Teams and assigned packs <span>→</span></a>
      </div>

      <div class="team-visual">
        <div class="pack-card">
          <div class="pack-title"><span>@northstar/packs/legal-core</span><strong>v18</strong></div>
          <div><span>contract-review</span><b>latest</b></div>
          <div><span>legal-research</span><b>latest</b></div>
          <div><span>citation-check</span><b>v3</b></div>
          <div><span>client-letter-draft</span><b>latest</b></div>
        </div>
        <div class="pack-assignment"><span>assigned once</span><i>→</i></div>
        <div class="member-grid">
          <div><span>A</span><small>4 skills</small></div>
          <div><span>B</span><small>4 skills</small></div>
          <div><span>C</span><small>4 skills</small></div>
          <div><span>new</span><small>syncs on join</small></div>
        </div>
      </div>
    </section>

    <section class="collaboration shell">
      <div class="collaboration-copy">
        <div class="section-label">Safe to edit</div>
        <h2>Edit a subscribed skill.<br />Keep your work.</h2>
        <p>
          Denju never treats somebody else's subscription as an untouchable folder. If you edit it,
          your change becomes your fork instead of silently changing upstream.
        </p>
        <a class="inline-link" href="/docs/guides/forks-and-proposals">Forks and proposals <span>→</span></a>
      </div>
      <div class="fork-flow">
        <div><span>01</span><strong>Edit normally</strong><p>Change the skill through the filesystem your agent already uses.</p></div>
        <div><span>02</span><strong>Your fork</strong><p>Denju preserves the edit as independent work with upstream history.</p></div>
        <div><span>03</span><strong>Propose it</strong><p>Send the result upstream when you want the original author to take it.</p></div>
      </div>
    </section>

    <section class="architecture shell">
      <div class="architecture-head">
        <div>
          <div class="section-label">Under the hood · optional</div>
          <h2>The architecture follows the product promise.</h2>
        </div>
        <p>
          Users should not have to think about synchronization mechanics. Denju does the technical work so
          “keep this skill current” remains a small, reliable promise.
        </p>
      </div>
      <div class="architecture-points">
        {architecturePoints.map(([title, body], index) => (
          <article><span>0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
      <a class="inline-link" href="/docs/architecture/overview">Read the architecture <span>→</span></a>
    </section>

    <section class="self-host shell">
      <div class="self-host-card">
        <div class="self-host-copy">
          <div class="section-label">Your registry, if you want it</div>
          <h2>Hosted by Denju.<br />Or hosted by you.</h2>
          <p>
            The official registry is the default. Organizations can run the same open-source
            <code>denju-server</code> against PostgreSQL and S3-compatible storage. The client experience
            stays the same.
          </p>
          <div class="self-host-actions">
            <a class="button button-primary" href="/docs/self-host/quickstart">Self-host Denju <span>→</span></a>
            <a class="button button-secondary" href="https://github.com/amxv/denju" target="_blank" rel="noreferrer">View source</a>
          </div>
        </div>
        <div class="infra-stack">
          <div class="infra-line" aria-hidden="true"></div>
          <div class="infra-main"><span>denju-server</span><small>same open-source server</small></div>
          <div class="infra-children">
            <div><strong>PostgreSQL</strong><small>accounts · skills · packs · teams</small></div>
            <div><strong>S3 compatible</strong><small>skill files and releases</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="quickstart shell">
      <div class="quickstart-card">
        <div class="quickstart-copy">
          <div class="section-label">Start here</div>
          <h2>Your first skill is four commands away.</h2>
          <p>Setup, search, and public subscriptions are anonymous. You can claim an identity later.</p>
        </div>
        <pre><code><span>$</span> denju setup
<span>$</span> denju search "react performance"
<span>$</span> denju show @ashray/react-performance
<span>$</span> denju subscribe @ashray/react-performance</code></pre>
        <div class="quickstart-actions">
          <a class="button button-inverse" href="/docs/start/install">Install Denju <span>→</span></a>
          <a class="text-link-inverse" href="/docs">Browse documentation →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
