# Copy to .env beside deploy/compose.yml or export these values before running Compose.
# Use URL-safe random password values because Compose constructs PostgreSQL URLs from them.
DENJU_DB_OWNER_PASSWORD=
DENJU_DB_APP_PASSWORD=
DENJU_DB_WORKER_PASSWORD=

DENJU_GARAGE_RPC_SECRET=
DENJU_S3_ACCESS_KEY_ID=
DENJU_S3_SECRET_ACCESS_KEY=
DENJU_S3_BUCKET=denju
DENJU_S3_PORT=3900
# Client-facing origin used in presigned upload/download URLs. The loopback default is for
# clients on the same host as this Compose stack. Remote clients must use an HTTPS origin that
# routes to this Garage S3 service instead.
DENJU_S3_PRESIGN_ENDPOINT=http://127.0.0.1:3900

DENJU_RECOVERY_TOKEN=
DENJU_PUBLIC_URL=http://127.0.0.1:7788
DENJU_PORT=7788

# Optional: pin a published server image instead of building the same Dockerfile locally.
# DENJU_SERVER_IMAGE=ghcr.io/amxv/denju-server:v1.0.0
