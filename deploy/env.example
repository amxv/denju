# denju-server configuration contract. Never place real secrets in this file.
DENJU_BIND=127.0.0.1:7788
DENJU_PUBLIC_URL=https://registry.denju.ashray.xyz

# PostgreSQL authority. Runtime request and worker credentials are separate restricted login
# roles. DENJU_DATABASE_DIRECT_URL is the session-mode `denju_app` endpoint used only for
# LISTEN/NOTIFY. Keep the migration-owner URL out of the ordinary server environment; provide it
# only to `denju-server migrate`.
DENJU_DATABASE_URL=postgresql://denju_app:replace-me-app@postgres:5432/denju
DENJU_DATABASE_WORKER_URL=postgresql://denju_worker:replace-me-worker@postgres:5432/denju
DENJU_DATABASE_DIRECT_URL=postgresql://denju_app:replace-me-app@postgres:5432/denju
# DENJU_DATABASE_MIGRATION_URL=postgresql://denju:replace-me-owner@postgres:5432/denju

# Dedicated deployment-recovery credential for bounded internal drain triggers. Keep this distinct
# from installation/session/automation/operator credentials and inject it only into the serving
# runtime that exposes /v1/internal/* recovery routes.
DENJU_RECOVERY_TOKEN=

# Generic S3-compatible object storage.
DENJU_S3_BUCKET=denju-registry
DENJU_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Optional separate client-facing S3 origin for presigned transfers. Leave unset when clients
# reach the same endpoint as the registry (for example Cloudflare R2). Self-hosted private-network
# S3 endpoints must set this to the externally reachable HTTPS origin.
# DENJU_S3_PRESIGN_ENDPOINT=https://objects.example.com
DENJU_S3_REGION=auto
DENJU_S3_ACCESS_KEY_ID=
DENJU_S3_SECRET_ACCESS_KEY=
DENJU_S3_FORCE_PATH_STYLE=false

# R2 note: private presigned transfers use the R2 S3 API hostname above.
# A public custom-domain/CDN endpoint, if added later, is a derived read cache only.
